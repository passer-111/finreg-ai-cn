# 项目名称定为 finreg-ai-cn（FINancial REGulation + AI + CN）
# 中文名：中国金融 AI 合规政策库
#
# ============================================================
# 【重要】改这个文件之前请先读这一段
#
# .gitignore **不支持行尾注释**。只有位于**行首**的 # 才是注释；
# 行中间或行尾的 # 会被当作模式的一部分。
#
# 也就是说，下面这种写法是**错的**：
#
#     __pycache__/      # 字节码目录
#
# git 会把「__pycache__/      # 字节码目录」整行当成一个文件名模式，
# 于是它匹配不到任何文件——规则完全失效，而文件本身看起来毫无问题。
#
# 本项目确实踩过这个坑：曾经把说明写在行尾，
# 导致 .coverage、__pycache__/*.pyc、*.egg-info/ 全都被提交进了仓库。
# 更隐蔽的是，.pytest_cache/ 与 .mypy_cache/ 之所以没被提交，
# 靠的是 pytest 与 mypy 自己在目录内生成的 .gitignore，而不是本文件的规则——
# 换个工具版本就未必还有这份侥幸。
#
# 因此本文件的约定是：**说明写在模式上方的独立一行**。
# 这与项目「每行都要有注释」的规则并不冲突，只是注释换了位置。
# ============================================================

# ============================================================
# Python 运行时产物 —— 本地跑出来的字节码缓存，不应入库
# ============================================================

# Python 解释器自动生成的字节码目录
__pycache__/
# 编译后的 .pyc / .pyo / .pyd 文件，换机器即失效
*.py[cod]
# Jython 编译产物，历史遗留，防止误提交
*$py.class


# ============================================================
# 虚拟环境 —— 每个开发者本地重建，依赖由 requirements.txt 声明
# ============================================================

# 标准虚拟环境目录名
.venv/
# 常见简写形式，一并忽略
venv/
# 另一种常见命名
env/
# Windows 上大小写不敏感，冗余忽略以防万一
ENV/


# ============================================================
# 打包与分发产物 —— 由构建工具生成，可重现，不入库
# ============================================================

# 构建中间目录
build/
# 最终分发包目录
dist/
# setuptools 元数据目录（pip install -e . 会生成）
*.egg-info/
# 旧版 setuptools 的临时 egg 存放处
.eggs/
# 本地构建的 wheel 缓存
wheels/


# ============================================================
# 测试与覆盖率产物
# ============================================================

# pytest 的测试缓存，加速重复运行但无需共享
.pytest_cache/
# 覆盖率数据文件（coverage.py 的默认输出名）
.coverage
# 覆盖率并行模式产生的带后缀数据文件（.coverage.hostname.pid）
.coverage.*
# 覆盖率 HTML 报告输出目录
htmlcov/
# CI 上传用的覆盖率 XML 报告
coverage.xml
# tox 多环境测试目录
.tox/
# nox 多环境测试目录
.nox/


# ============================================================
# 类型检查与代码质量工具的缓存
# ============================================================

# mypy 增量类型检查缓存
.mypy_cache/
# ruff 检查器缓存
.ruff_cache/
# dmypy 守护进程状态文件
.dmypy.json


# ============================================================
# 编辑器与操作系统杂项 —— 因人而异，不该污染仓库
# ============================================================

# VS Code 工作区配置（如需共享可改用 .vscode/settings.json 白名单）
.vscode/
# JetBrains 系列 IDE 配置目录
.idea/
# Vim 交换文件
*.swp
# Vim 交换文件（备选扩展名）
*.swo
# 编辑器生成的备份文件
*~
# macOS Finder 元数据文件
.DS_Store
# Windows 资源管理器缩略图缓存
Thumbs.db
# Windows 文件夹自定义配置
desktop.ini


# ============================================================
# 【重要】本项目专属：抓取过程的临时文件
# 说明：data/snapshots/ 下的原始快照是要入库的（用于事后重建与结构变更检测），
#       但下面这些临时中间件不入库。
# ============================================================

# 抓取过程中未完成的临时快照，完成后才移动到正式路径
data/snapshots/tmp/
# 下载未完成的文件后缀
*.part
# 通用临时文件
*.tmp


# ============================================================
# 【重要】本项目专属：静态站点的构建产物
# 说明：`finreg build-site` 会把 data/ 渲染成 docs/ 下的完整站点。
#       它是**构建产物**，是 git 数据的一个纯函数式视图——同一份数据
#       重新生成一次就完全一样，因此不入库。
#
#       为什么不提交：仓库里已经有 fetch.yml 会自动提交数据变更，
#       若再把生成的 HTML 一并提交，每次数据变化都会同时产生两份 diff，
#       两个自动提交互相竞争的概率成倍上升。发布改走
#       .github/workflows/pages.yml，在 CI 里构建并作为 Pages 产物上传。
# ============================================================

# 站点构建输出目录
/docs/
# 本地预览时可能用到的临时输出目录
/docs-preview/


# ============================================================
# 【重要】凭据与本地配置 —— 绝不允许入库
# 说明：本项目原则上不需要任何密钥（只用公开政府网站），
#       但保留这些规则以防后续引入代理或对象存储。
# ============================================================

# 本地环境变量文件
.env
# 本地覆盖用环境变量文件
.env.local
# 密钥文件
*.key
# 证书私钥文件
*.pem
# 本地密钥配置
secrets.yaml


# ============================================================
# 【重要】法律风险隔离：第三方非官方来源的原始抓取内容一律不入库
# 说明：本项目只允许提交官方站点（primary tier）的原文快照。
#       若有任何 secondary 来源的原始 HTML 被下载，必须隔离在下面这个目录，
#       且永不提交，以规避第三方汇编作品的著作权风险。
# ============================================================

# secondary 来源的隔离区，禁止提交
data/snapshots/_secondary_quarantine/

# 本机双击启动核验台的脚本：内含本机 venv 绝对路径，属机器特定文件，不入库
启动核验台.bat
