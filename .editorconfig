# .editorconfig —— 统一所有贡献者的编辑器行为，避免因空白字符产生无意义的 diff
# 官方规范：https://editorconfig.org

# 标记为顶层配置，EditorConfig 解析到此为止，不再向父目录查找
root = true

# ============================================================
# 所有文件的通用默认规则
# ============================================================
[*]
# 使用 UTF-8 编码 —— 本项目含大量中文政策文本，编码错误会直接损坏数据
charset = utf-8
# 使用 LF 换行 —— 避免 Windows(CRLF) 与 Unix(LF) 混用导致的整文件 diff
end_of_line = lf
# 文件末尾保留一个空行 —— 符合 POSIX 规范，也避免某些工具告警
insert_final_newline = true
# 删除行尾多余空格 —— 减少无意义的 diff 噪音
trim_trailing_whitespace = true
# 每条规则之间保留一个空行，提升可读性
# （此行为偏好设置，部分编辑器支持）
# 缩进宽度默认 2 空格，与 YAML/JSON 生态一致
indent_size = 2
# 默认使用空格而非制表符，保证跨编辑器渲染一致
indent_style = space

# ============================================================
# Python 源码 —— 遵循 PEP 8 的 4 空格缩进
# ============================================================
[*.py]
# PEP 8 规定使用 4 空格缩进
indent_size = 4
# 明确使用空格缩进
indent_style = space
# 单行最大长度 120 —— 比 PEP 8 的 79 更宽松，因中文注释占宽较大
max_line_length = 120

# ============================================================
# YAML 配置与数据文件 —— 2 空格缩进，这是 YAML 的事实标准
# ============================================================
[*.{yaml,yml}]
# YAML 对缩进极为敏感，严格 2 空格
indent_size = 2
# 必须使用空格，绝不允许制表符（YAML 规范明确禁止 tab 缩进）
indent_style = space

# ============================================================
# JSON 文件 —— 2 空格缩进，与 YAML 保持一致
# ============================================================
[*.json]
# JSON 生态通用为 2 空格
indent_size = 2
# 使用空格缩进
indent_style = space

# ============================================================
# Markdown 文档 —— 不限制行宽，因为长段落换行会破坏渲染效果
# ============================================================
[*.md]
# 关闭行尾空格清理 —— Markdown 中行尾两个空格是有语义的（强制换行）
trim_trailing_whitespace = false
# 不设置 max_line_length，避免编辑器在长中文段落中插入硬换行

# ============================================================
# Shell 脚本 —— 本项目有少量辅助脚本，遵循 4 空格
# ============================================================
[*.sh]
# Shell 脚本使用 4 空格缩进以区别于 YAML
indent_size = 4
# 使用空格缩进
indent_style = space

# ============================================================
# Makefile —— 语法要求必须使用制表符，EditorConfig 需明确放行
# ============================================================
[Makefile]
# Makefile 的菜谱行必须用 tab 开头，否则 make 会报错
indent_style = tab
